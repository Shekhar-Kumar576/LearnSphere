# LearnSphere AI - Firebase Authentication Configuration
# (Optional) If you want real Google Sign-In via Firebase, copy this file to .env
# and add your values from Firebase Console -> Project Settings -> General -> Your apps -> Web app.
# If these are not provided, the app runs in Instant Demo Mode automatically!

VITE_FIREBASE_API_KEY=your_actual_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
